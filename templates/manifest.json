          "min": 256,
          "max": 2048,
          "default": 1024,
          "targets": [{ "node": "11", "input": "height" }],
          "description": "高（像素）"
        },
        "batch": { "type": "integer", "min": 1, "max": 4, "default": 1, "targets": [{ "node": "11", "input": "batch_size" }], "description": "batch 张数" },
        "seed": { "type": "integer", "min": 0, "targets": [{ "node": "2", "input": "seed" }], "description": "随机种子（可选）" }
      },
