        },
        "negative": { "type": "string", "maxLength": 2000, "targets": [{ "node": "6", "input": "text" }], "description": "反向描述（可选）" },
        "width": { "type": "integer", "min": 256, "max": 2048, "default": 1024, "targets": [{ "node": "11", "input": "width" }], "description": "宽（像素）" },
        "height": {
