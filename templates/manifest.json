{
  "$comment": "ComfyUI 工作流模板清单（本包能力唯一真源；调用方先调 comfy_templates 再提交，模板必须显式指定）。数值限额为模板级通用约束（时长/字节/数量），仅作本包校验用，不引用任何业务路由 id。模板文件由上游移植源改名收录（通用名），内容为 API 格式工作流。",
  "version": 1,
  "templates": {
    "video-t2v": {
      "file": "video-t2v-api.json",
      "kind": "video",
      "description": "Text-to-video: prompt + duration + aspect + seed.",
      "params": {
        "prompt": {
          "type": "string",
          "required": true,
          "minLength": 1,
          "maxLength": 6000,
          "targets": [{ "node": "131", "input": "prompt" }],
          "description": "成品正文字符串（调用方自备，原文写入）"
        },
        "durationSec": {
          "type": "integer",
          "required": true,
          "min": 4,
          "max": 15,
          "targets": [{ "node": "133", "input": "value" }],
          "description": "时长秒（整数）"
        },
        "aspect": {
          "type": "string",
          "enum": ["16:9", "9:16"],
          "default": "16:9",
          "sizeMap": { "16:9": [1344, 768], "9:16": [768, 1344] },
          "targets": [
            { "node": "147", "input": "value", "from": "aspectSize", "axis": 0 },
            { "node": "148", "input": "value", "from": "aspectSize", "axis": 1 }
          ],
          "description": "画幅（驱动宽高）"
        },
        "seed": { "type": "integer", "min": 0, "targets": [{ "node": "129", "input": "noise_seed" }], "description": "随机种子（可选）" }
      },
      "assets": {},
      "outputs": [{ "node": "92", "kind": "video" }]
    },
    "video-t2v-1080p": {
      "file": "video-t2v-1080p-api.json",
      "kind": "video",
      "description": "Text-to-video, high-resolution variant (progressive sampler, slower).",
      "params": {
        "prompt": {
          "type": "string",
          "required": true,
          "minLength": 1,
          "maxLength": 6000,
          "targets": [{ "node": "136", "input": "prompt" }],
          "description": "成品正文字符串（调用方自备，原文写入）"
        },
        "durationSec": {
          "type": "integer",
          "required": true,
          "min": 4,
          "max": 15,
          "targets": [{ "node": "132", "input": "value" }],
          "description": "时长秒（整数）"
        },
        "aspect": {
          "type": "string",
          "enum": ["16:9", "9:16"],
          "default": "16:9",
          "labelMap": { "16:9": "16:9 (Widescreen)", "9:16": "9:16 (Portrait Widescreen)" },
          "targets": [{ "node": "115", "input": "aspect_ratio", "from": "aspectLabel" }],
          "description": "画幅（驱动分辨率选择器）"
        },
        "seed": { "type": "integer", "min": 0, "targets": [{ "node": "235", "input": "seed" }], "description": "随机种子（可选）" }
      },
      "assets": {},
      "outputs": [{ "node": "180", "kind": "video" }]
    },
